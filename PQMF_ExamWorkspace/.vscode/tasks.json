{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Restricted mode: check AI extensions",
      "type": "shell",
      "command": "${command:workbench.action.terminal.sendSequence}",
      "windows": {
        "command": "pwsh -NoProfile -Command \"& '${workspaceFolder}\\.vscode\\extensions.ps1' 'check'\""
      },
      "osx": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" check"
      },
      "linux": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" check"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Restricted mode: watch AI usage",
      "type": "shell",
      "windows": {
        "command": "pwsh -NoProfile -Command \"& '${workspaceFolder}\\.vscode\\extensions.ps1' 'watch'\""
      },
      "osx": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" --watch"
      },
      "linux": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" --watch"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Restricted mode: instructor reset (disable AI & restore theme)",
      "type": "shell",
      "windows": {
        "command": "pwsh -NoProfile -Command \"& '${workspaceFolder}\\.vscode\\extensions.ps1' 'reset'\""
      },
      "osx": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" --reset"
      },
      "linux": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" --reset"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
