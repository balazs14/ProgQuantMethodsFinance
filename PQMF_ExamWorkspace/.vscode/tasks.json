{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Restricted mode: watch AI usage",
      "type": "process",
      "command": "sh",
      "args": [
        "${workspaceFolder}/.vscode/extensions.sh",
        "--watch"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\.vscode\\extensions.ps1",
          "watch"
        ]
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": []
    },
    {
      "label": "Restricted mode: student terminal",
      "type": "process",
      "command": "bash",
      "args": [
        "--rcfile",
        "${workspaceFolder}/.vscode/terminal-rc.sh",
        "-i"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-NoExit",
          "-Command",
          ". '${workspaceFolder}\\.vscode\\terminal-rc.ps1'"
        ]
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Restricted mode: instructor reset (repair files & restore theme)",
      "type": "shell",
      "command": "${command:pqmfExamGuard.instructorReset}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
