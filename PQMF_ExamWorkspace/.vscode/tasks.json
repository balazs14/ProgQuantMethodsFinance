{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Restricted mode: check AI extensions",
      "type": "shell",
      "command": "${command:workbench.action.terminal.sendSequence}",
      "windows": {
        "command": "& '${workspaceFolder}\\.vscode\\extensions.ps1' 'check'"
      },
      "osx": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" check"
      },
      "linux": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" check"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": []
    },
    {
      "label": "Restricted mode: watch AI usage",
      "type": "shell",
      "windows": {
        "command": "& '${workspaceFolder}\\.vscode\\extensions.ps1' 'watch'"
      },
      "osx": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" --watch"
      },
      "linux": {
        "command": "sh \"${workspaceFolder}/.vscode/extensions.sh\" --watch"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": []
    },
    {
      "label": "Restricted mode: student terminal",
      "type": "shell",
      "windows": {
        "command": "pwsh -NoProfile -NoExit -Command \". '${workspaceFolder}\\.vscode\\terminal-rc.ps1'\""
      },
      "osx": {
        "command": "bash --rcfile \"${workspaceFolder}/.vscode/terminal-rc.sh\" -i"
      },
      "linux": {
        "command": "bash --rcfile \"${workspaceFolder}/.vscode/terminal-rc.sh\" -i"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Restricted mode: instructor reset (repair files & restore theme)",
      "type": "shell",
      "command": "${command:pqmfExamGuard.instructorReset}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
